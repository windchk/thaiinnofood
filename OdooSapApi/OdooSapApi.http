@OdooSapApi_HostAddress = http://localhost:5134

POST {{OdooSapApi_HostAddress}}/api/sap/production/receipt
Content-Type: application/json
Accept: application/json

{
  "siteId": "TEST",
  "docEntry": 48821,
  "docDate": "2026-06-27",
  "receiptLines": [
    {
      "quantity": 10,
      "warehouse": "WH-FG",
      "batches": [
        {
          "batchNumber": "FG-BATCH-001",
          "quantity": 4
        },
        {
          "batchNumber": "FG-BATCH-002",
          "quantity": 6
        }
      ]
    }
  ]
}

###

# WARNING: This request creates a real Goods Issue in TIF and Goods Receipt in STL.
POST {{OdooSapApi_HostAddress}}/api/sap/goodsissue-goodsreceipt
Content-Type: application/json
Accept: application/json

{
  "transferId": "ODOO-TEST-20260723-0001",
  "siteId": "TEST",
  "sourceCompanyName": "TEST_INTERFACE",
  "targetCompanyName": "TEST_STL_ODOO",
  "postingDate": "2026-07-23",
  "remarks": "Transfer stock from TIF to STL",
  "lines": [
    {
      "lineId": "1",
      "itemCode": "FG08006",
      "quantity": 10,
      "sourceWarehouse": "WH-FG",
      "targetWarehouse": "WH-FG",
      "batches": [
        {
          "batchNumber": "FG-BATCH-001",
          "quantity": 4
        },
        {
          "batchNumber": "FG-BATCH-002",
          "quantity": 6
        }
      ]
    }
  ]
}

###

GET {{OdooSapApi_HostAddress}}/api/sap/goodsissue-goodsreceipt/ODOO-TEST-20260723-0001?siteId=TEST
Accept: application/json

###

# WARNING: This request creates a real SAP Delivery based on an A/R Reserve Invoice.
POST {{OdooSapApi_HostAddress}}/api/sap/delivery
Content-Type: application/json
Accept: application/json

{
  "siteId": "TEST",
  "companyName": "TEST_INTERFACE",
  "docEntry": 999999999,
  "docDate": "2026-07-23",
  "comments": "Created from Odoo",
  "deliveryLines": [
    {
      "lineNum": 0,
      "quantity": 10,
      "warehouse": "WH-FG",
      "batches": [
        {
          "batchNumber": "FG-BATCH-001",
          "quantity": 4
        },
        {
          "batchNumber": "FG-BATCH-002",
          "quantity": 6
        }
      ]
    }
  ]
}

